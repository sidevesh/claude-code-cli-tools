#!/usr/bin/env python3
"""claude-profile-move - move or copy Claude Code projects between config profiles.

A "project" is two things, and both must move together:
  1. <config>/projects/<slug>/          transcripts + memory
  2. <config>/.claude.json -> projects["<abs path>"]   trust + per-project settings

Usage:
  claude-profile-move --profiles                 list config profiles
  claude-profile-move --list                     all projects, with last-active
  claude-profile-move --dupes                    projects present in >1 profile
  claude-profile-move PROJECT --to work          move (PROJECT = slug or path)
  claude-profile-move PROJECT --to default --copy
  claude-profile-move PROJECT --to work --dry-run

Profiles are a naming convention: "default" is ~/.claude, any other name X is
~/.claude-X. Nothing to register.

Per-profile shell aliases are generated by `claude-remote-launch --shell-init`.

Options:
  --profiles         list config profiles and exit
  --list             list all projects by last-active, and exit
  --dupes            list projects present in more than one profile, and exit
  --to NAME          target profile, e.g. default or work  (required to move)
  --from NAME        source profile (default: whichever profile has it)
  --copy             copy instead of move
  --prefer-newer     on collision keep the more recently active copy
  --force            on collision overwrite the target
  --dry-run          print the plan, change nothing
  --update [--check] update both commands and the shared module; --check only
                     reports whether an update exists. -y / --yes skips the
                     prompt (or set CLAUDE_CLI_TOOLS_ASSUME_YES=1).
  -v, --version      print version and exit
  -h, --help

Last-active comes from timestamps embedded in the .jsonl transcripts, not file
mtime: mtime gets rewritten by copies, backups and cleanup passes and routinely
overstates real activity. Rows marked (mtime) had no usable timestamp.
"""

import os
import shutil
import sys

# Locate the shared module. bin/ goes on PATH and must hold only executables,
# so the module lives in a sibling lib/ - either <prefix>/lib/claude-code-cli-tools
# (installed) or <repo>/lib (git checkout). realpath() resolves symlinks first.
# Don't leave a __pycache__ beside the installed module: the install is meant
# to be exactly three files. The module is small, so recompiling each run is
# cheaper than the clutter.
sys.dont_write_bytecode = True

_here = os.path.dirname(os.path.realpath(__file__))
_prefix = os.path.dirname(_here)
for _cand in (os.path.join(_prefix, "lib", "claude-code-cli-tools"),
              os.path.join(_prefix, "lib"),
              os.path.expanduser("~/.local/lib/claude-code-cli-tools")):
    if os.path.isfile(os.path.join(_cand, "claude_profile_lib.py")):
        sys.path.insert(0, _cand)
        break
else:
    sys.stderr.write("error: claude_profile_lib.py not found; reinstall\n")
    raise SystemExit(1)
from claude_profile_lib import (  # noqa: E402
    __version__, config_dir, config_json_path, die, discover_profiles,
    do_update, fmt_when, last_active, list_projects, load_json, path_to_slug,
    print_profiles, print_projects, profile_dir, projects_dir, resolve_dir,
    save_json_atomic, warn,
)


def cmd_dupes():
    profs = discover_profiles()
    by_slug = {}
    counts = []
    for prof in profs:
        projs = list_projects(config_dir(prof))
        counts.append("%d in %s" % (len(projs), prof))
        for slug, info in projs.items():
            by_slug.setdefault(slug, []).append((prof, info))

    dupes = {s: v for s, v in by_slug.items() if len(v) > 1}
    if not dupes:
        print("No duplicated projects: %s, 0 shared." % ", ".join(counts))
        return 0

    print("%d project(s) present in more than one profile:\n" % len(dupes))
    for slug in sorted(dupes):
        entries = dupes[slug]
        print("  %s" % entries[0][1]["real_path"])
        dated = [(p, i) for p, i in entries if i["last_active"]]
        newest = max(dated, key=lambda pi: pi[1]["last_active"])[0] if dated else None
        width = max(len(p) for p, _ in entries)
        for prof, info in entries:
            print("    %-*s %s%s" % (width, prof, fmt_when(info["last_active"]),
                                     "   <- newer" if prof == newest else ""))
        print()
    return 0


def find_project(ident, from_profile):
    """-> (profile, slug, info). ident may be a slug or a real path."""
    cand = []
    profiles = [from_profile] if from_profile else list(discover_profiles())
    for prof in profiles:
        projs = list_projects(config_dir(prof))
        if ident in projs:
            cand.append((prof, ident, projs[ident]))
            continue
        slug = path_to_slug(resolve_dir(ident))
        if slug in projs:
            cand.append((prof, slug, projs[slug]))
            continue
        for slug2, info in projs.items():
            if os.path.realpath(info["real_path"]) == os.path.realpath(
                    resolve_dir(ident)):
                cand.append((prof, slug2, info))
                break
    if not cand:
        die("project %r not found in %s" % (ident, " or ".join(profiles)))
    if len(cand) > 1:
        die("project %r exists in multiple profiles (%s) - pass --from"
            % (ident, ", ".join(c[0] for c in cand)))
    return cand[0]


def move_json_entry(src_json, dst_json, real_path, copy, dry):
    src = load_json(src_json)
    entry = src.get("projects", {}).get(real_path)
    if entry is None:
        warn("no .claude.json entry for %s (dir moved anyway)" % real_path)
        return
    if dry:
        print("  would %s config entry for %s"
              % ("copy" if copy else "move", real_path))
        return
    dst = load_json(dst_json)
    dst.setdefault("projects", {})[real_path] = entry
    save_json_atomic(dst_json, dst)
    if not copy:
        src["projects"].pop(real_path, None)
        save_json_atomic(src_json, src)


def cmd_move(ident, to_profile, from_profile, copy, prefer_newer, force, dry):
    if not to_profile:
        die("--to is required (e.g. --to default, --to work)")
    if not os.path.isdir(profile_dir(to_profile)):
        die("unknown profile %r -> %s does not exist (known: %s)"
            % (to_profile, profile_dir(to_profile),
               ", ".join(discover_profiles()) or "none found"))

    src_prof, slug, info = find_project(ident, from_profile)
    if src_prof == to_profile:
        die("project is already in profile %r" % to_profile)

    src_cfg, dst_cfg = config_dir(src_prof), config_dir(to_profile)
    src_dir = info["path"]
    dst_dir = os.path.join(projects_dir(dst_cfg), slug)

    if not info["exact"]:
        warn("could not read the real path from transcripts; guessed %r. "
             "The config entry may not transfer." % info["real_path"])

    print("%s %s" % ("copy" if copy else "move", info["real_path"]))
    print("  from : %s  (%s)" % (src_prof, src_dir))
    print("  to   : %s  (%s)" % (to_profile, dst_dir))
    print("  last active: %s (%s)" % (fmt_when(info["last_active"]), info["source"]))

    if os.path.exists(dst_dir):
        dst_when, dst_src = last_active(dst_dir)
        print("\n  COLLISION: target already has this project")
        print("    source last active: %s (%s)" % (fmt_when(info["last_active"]),
                                                   info["source"]))
        print("    target last active: %s (%s)" % (fmt_when(dst_when), dst_src))
        s_dt, d_dt = info["last_active"], dst_when
        if prefer_newer:
            if d_dt and (not s_dt or d_dt >= s_dt):
                print("  --prefer-newer: target is newer, keeping it. Nothing done.")
                return 0
            print("  --prefer-newer: source is newer, replacing target.")
        elif not force:
            die("target exists; pass --prefer-newer or --force")
        bak = dst_dir + ".bak"
        n = 1
        while os.path.exists(bak):
            bak = "%s.bak%d" % (dst_dir, n)
            n += 1
        if dry:
            print("  would back up target -> %s" % bak)
        else:
            shutil.move(dst_dir, bak)
            print("  backed up target -> %s" % bak)

    if dry:
        print("  would %s dir" % ("copy" if copy else "move"))
    else:
        os.makedirs(projects_dir(dst_cfg), exist_ok=True)
        if copy:
            shutil.copytree(src_dir, dst_dir)
        else:
            try:
                os.rename(src_dir, dst_dir)  # atomic on same filesystem
            except OSError:
                shutil.copytree(src_dir, dst_dir)
                shutil.rmtree(src_dir)

    move_json_entry(config_json_path(src_cfg), config_json_path(dst_cfg),
                    info["real_path"], copy, dry)

    print("done." if not dry else "(dry run - nothing changed)")
    return 0


def main(argv):
    if not argv:
        print(__doc__.rstrip())
        print("\nclaude-code-cli-tools %s" % __version__)
        return 0
    ident = None
    to_p = from_p = None
    copy = prefer_newer = force = dry = False

    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print(__doc__.rstrip())
            print("\nclaude-code-cli-tools %s" % __version__)
            return 0
        elif a in ("-v", "--version"):
            print("claude-code-cli-tools %s" % __version__)
            return 0
        elif a == "--update":
            return do_update(check_only="--check" in argv,
                             assume_yes="--yes" in argv or "-y" in argv)
        elif a in ("--check", "-y", "--yes"):
            pass  # consumed by --update
        elif a == "--list":
            return print_projects()
        elif a == "--profiles":
            return print_profiles()
        elif a == "--dupes":
            return cmd_dupes()
        elif a in ("--to", "--from"):
            i += 1
            if i >= len(argv):
                die("%s needs a value" % a)
            if a == "--to":
                to_p = argv[i]
            else:
                from_p = argv[i]
        elif a.startswith("--to="):
            to_p = a.split("=", 1)[1]
        elif a.startswith("--from="):
            from_p = a.split("=", 1)[1]
        elif a == "--copy":
            copy = True
        elif a == "--prefer-newer":
            prefer_newer = True
        elif a == "--force":
            force = True
        elif a == "--dry-run":
            dry = True
        elif not a.startswith("-") and ident is None:
            ident = a
        else:
            die("unrecognised argument %r" % a)
        i += 1

    if ident is None:
        die("need a PROJECT (slug or path), or --list / --dupes")
    return cmd_move(ident, to_p, from_p, copy, prefer_newer, force, dry)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
